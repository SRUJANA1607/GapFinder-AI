# GapFinder AI - Environment Variables
# Copy this file to .env.local and fill in your actual credentials.
# Do NOT commit .env.local to Git.

# --- Supabase Configuration (Required) ---
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- Demo Login Accounts (Server-Only, Required for 1-Click Demo Evaluation) ---
# Create these demo accounts in Supabase Auth (Users -> Add user).
# These credentials stay strictly on the server and are never exposed to browser bundles.
DEMO_STUDENT_EMAIL=demo_student@example.com
DEMO_STUDENT_PASSWORD=your_secure_student_password_here
DEMO_TEACHER_EMAIL=demo_teacher@example.com
DEMO_TEACHER_PASSWORD=your_secure_teacher_password_here

# --- Google Gemini AI API Key (Optional) ---
# Free key from Google AI Studio (https://aistudio.google.com/app/apikey)
# Enables live Gemini Flash generation (intelligent grounded fallback works if unset).
GEMINI_API_KEY=your-gemini-api-key-here
